# ==============================================================================
# API Gatekeeper Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and should never be committed

# ==============================================================================
# DATABASE CONFIGURATION (Required for Flask Server)
# ==============================================================================

# REQUIRED: Password for the api_auth_admin database user
# This is used by the Flask server to connect to PostgreSQL
API_AUTH_ADMIN_PG_PASSWORD=your_secure_password_here

# OPTIONAL: PostgreSQL Connection Settings
# Defaults shown below - uncomment and modify if different from defaults
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# OPTIONAL: Application Database User
# Default: api_auth_admin
# API_AUTH_ADMIN_PG_USER=api_auth_admin

# OPTIONAL: Application Database Name
# Default: api_auth_admin
# API_AUTH_ADMIN_PG_DB=api_auth_admin

# ==============================================================================
# DATABASE SETUP SCRIPT (Required for dev_scripts/setup_database.py)
# ==============================================================================

# REQUIRED for database setup: PostgreSQL superuser password
# This is only needed when running dev_scripts/setup_database.py to create
# the database and user. Not needed for normal Flask server operation.
# PG_PASSWORD=postgres_superuser_password

# OPTIONAL: PostgreSQL superuser name
# Default: postgres
# POSTGRES_USER=postgres

# ==============================================================================
# FLASK SERVER CONFIGURATION
# ==============================================================================

# OPTIONAL: Flask server port
# Default: 7843
# PORT=7843

# OPTIONAL: Log level
# Controls the verbosity of application logging
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# LOG_LEVEL=INFO

# OPTIONAL: Local debug mode
# Set to 'true' for local development (console logs), 'false' for production (Loki)
# Default: true
# DEBUG_LOCAL=true

# ==============================================================================
# REDIS CONFIGURATION (Required for Rate Limiting)
# ==============================================================================
# If REDIS_HOST is not set, rate limiting is disabled
# If REDIS_HOST is set but connection fails, the application will exit

# OPTIONAL: Redis server hostname
# REDIS_HOST=localhost

# OPTIONAL: Redis server port (default: 6379)
# REDIS_PORT=6379

# OPTIONAL: Redis password (if authentication is enabled)
# REDIS_PASSWORD=your_redis_password

# OPTIONAL: Redis database number (default: 0)
# REDIS_DB=0

# ==============================================================================
# TRUSTED FORWARDER IPS (Optional)
# ==============================================================================
# Comma-separated list of upstream server IPs that are trusted to forward the
# real client IP via the X-Original-Client-IP header.
#
# Use case: When an upstream server makes auth subrequests to gatekeeper through
# Cloudflare, Cloudflare sets CF-Connecting-IP to the upstream server's IP
# instead of the original client. The upstream server can set X-Original-Client-IP
# to the real client IP, and gatekeeper will trust it only if the caller is in
# this list.
#
# Example: TRUSTED_FORWARDER_IPS=203.0.113.10,203.0.113.20
# TRUSTED_FORWARDER_IPS=

# ==============================================================================
# CORS ALLOWLIST (Optional, but required for cross-origin browser callers)
# ==============================================================================
# Comma-separated list of origins (scheme://host[:port]) allowed to make
# cross-origin requests to gatekeeper-protected services. When set:
#   - /authz short-circuits OPTIONS preflights for matching routes and returns
#     CORS preflight headers (auth_request consumer's nginx must propagate them
#     via auth_request_set + return 204; see NGINX_CONF_SKILL.md).
#   - Actual /authz responses (200 and 4xx) carry Access-Control-Allow-Origin
#     and Vary: Origin so browsers can read denial reasons.
# When unset, OPTIONS preflights are denied with method_not_configured unless
# OPTIONS is explicitly added to a route's allowed-methods list.
#
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
# CORS_ALLOWED_ORIGINS=

# ==============================================================================
# AEGIS WEBHOOK CONFIGURATION (Optional)
# ==============================================================================
# Enables provisioning of console administrators from Aegis user.verified
# webhook events. When Aegis fires a user.verified webhook, the gatekeeper
# creates a matching console_admins record IF the email is on the allowlist
# below. Both vars must be set for provisioning to occur.

# Shared HMAC-SHA256 secret generated by Aegis when the site's webhook_url
# was configured. Webhooks with invalid signatures are rejected with 401.
# AEGIS_WEBHOOK_SECRET=

# Comma-separated allowlist of email addresses authorized to become console
# admins. Matched case-insensitively. If unset or empty, NO users will be
# provisioned (safe OSS default).
#
# Example: AEGIS_ADMIN_EMAILS=owner@example.com,ops@example.com
# AEGIS_ADMIN_EMAILS=

# ==============================================================================
# AEGIS BEARER AUTH (Required for admin console endpoints)
# ==============================================================================
# The admin console authenticates API requests by presenting an Aegis-issued
# bearer token. The gatekeeper calls Aegis's /api/auth/me to resolve the token
# to a user, then checks that user exists in console_admins.
#
# If AEGIS_API_URL is unset, admin endpoints guarded by @require_console_admin
# return 503 — the webhook path still works so existing admins can be
# provisioned, but the console UI cannot authenticate.
#
# Example: AEGIS_API_URL=https://aegis.example.com
# AEGIS_API_URL=

# Positive-result cache TTL for authenticated tokens, in seconds.
# Shorter = faster propagation when an admin is deprovisioned / token revoked.
# Longer  = fewer round-trips to Aegis under load.
# Default: 60. Set to 0 to disable caching entirely.
# AEGIS_AUTH_CACHE_TTL_SECONDS=60

# ==============================================================================
# AEGIS PUBLIC AUTH PROXY (Required for /api/auth/* proxy endpoints)
# ==============================================================================
# The frontend's login / register / verify-email / password-reset flows call
# this backend's /api/auth/* endpoints, which proxy to Aegis with the per-tenant
# API key attached server-side (Aegis requires X-Tenant-Api-Key on those six
# public endpoints; the key must NEVER ship to the browser).
#
# Both vars are required for the proxy. If either is unset, the proxy returns
# 500 on every call. The bearer-only admin path above (AEGIS_API_URL) does not
# need either of these.

# REQUIRED: Aegis site ID assigned to this gatekeeper instance.
# Get this from the Aegis admin console after creating the site record.
# AEGIS_SITE_ID=1

# REQUIRED: Per-tenant API key issued by Aegis when the site was created
# (or rotated via regenerate_tenant_api_key). Treat as a secret — anyone
# with this key can register / log in users against your site.
# AEGIS_TENANT_API_KEY=

# ==============================================================================
# FRONTEND RUNTIME CONFIG (Served by GET /api/config)
# ==============================================================================
# The gatekeeper-frontend image is tenant-agnostic — it fetches these values
# at first paint via /api/config so a single image can deploy across tenants
# without rebuilding. Set these to whatever you want shown in the admin UI.

# Display-only branding shown in the console header. No security significance.
# Default: "gatekeeper"
# SITE_NAME=gatekeeper

# Domain shown in the console UI (e.g. login crumb, footer). No security
# significance — used purely for display.
# Example: SITE_DOMAIN=gatekeeper.example.com
# SITE_DOMAIN=

# ==============================================================================
# LOKI LOGGING CONFIGURATION (Production Only)
# ==============================================================================
# These are required when DEBUG_LOCAL=false (production mode)
# Provides centralized logging with Grafana Loki

# REQUIRED (production): Loki server endpoint
# LOKI_ENDPOINT=https://loki.example.com:8443/loki/api/v1/push

# REQUIRED (production): Loki authentication credentials
# LOKI_USER=your_loki_username
# LOKI_PASSWORD=your_loki_password

# REQUIRED (production): Path to CA certificate for secure Loki connection.
# If the Loki endpoint uses a publicly trusted cert, omit this variable.
# LOKI_CA_BUNDLE_PATH=/app/certs/loki-ca.pem

# ==============================================================================
# GITHUB ACCESS (Required for pip install of byteforge-loki-logging)
# ==============================================================================
# Personal Access Token with repo access to jmazzahacks/byteforge-loki-logging
# CR_PAT=your_github_personal_access_token
